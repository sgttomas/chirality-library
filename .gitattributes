# Whitespace policy for exact-byte governed artifacts. These attributes keep
# optional local `git diff --check` diagnostics quiet on preserved bytes;
# cosmetic whitespace does not gate CI.
#
# CRLF-terminated snapshot manifests: the carriage return is the line
# terminator of the file, not trailing whitespace.
execution/_Decomposition/**/*.csv whitespace=cr-at-eol
# Unified-diff artifacts carry format-mandated blank context lines (a single
# space); disable whitespace checks for them entirely.
execution/_ScopeChange/**/*.patch -whitespace

# Shell scripts must keep LF line endings to run.
*.sh text eol=lf
