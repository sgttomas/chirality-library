{
  "schema": "chirality-software-workflow/v1",
  "project_root": "..",
  "description": "Path-selected tool regressions and repository contracts. Unknown inputs and unavailable diffs select full coverage.",
  "always_checks": [],
  "checks": {
    "coordination": {
      "pytest_paths": [
        "tools/coordination"
      ]
    },
    "decomp": {
      "pytest_paths": [
        "tools/decomp"
      ]
    },
    "pdf2md": {
      "pytest_paths": [
        "tools/pdf2md"
      ]
    },
    "release": {
      "pytest_paths": [
        "tools/release"
      ]
    },
    "reporting": {
      "pytest_paths": [
        "tools/reporting"
      ]
    },
    "retrieval": {
      "pytest_paths": [
        "tools/retrieval"
      ]
    },
    "scope_of_work": {
      "pytest_paths": [
        "tools/scope_of_work"
      ]
    },
    "software_workflow": {
      "pytest_paths": [
        "tools/software_workflow"
      ]
    },
    "source_audit": {
      "pytest_paths": [
        "tools/source_audit"
      ]
    },
    "source_catalog": {
      "pytest_paths": [
        "tools/source_catalog"
      ]
    },
    "validation": {
      "pytest_paths": [
        "tools/validation"
      ]
    },
    "workflow_runtime": {
      "pytest_paths": [
        "tools/workflow_runtime"
      ]
    },
    "evaluation": {
      "pytest_paths": [
        "tools/evaluation"
      ]
    },
    "scaffolding": {
      "pytest_paths": [
        "tools/scaffolding"
      ]
    },
    "deliverables": {
      "pytest_paths": [
        "tools/deliverables"
      ]
    },
    "drawing_extract": {
      "pytest_paths": [
        "tools/drawing_extract"
      ]
    },
    "equation_audit": {
      "pytest_paths": [
        "tools/equation_audit"
      ]
    },
    "publication": {
      "pytest_paths": [
        "tools/publication"
      ]
    }
  },
  "path_rules": [
    {
      "paths": [
        "tools/coordination/*"
      ],
      "checks": [
        "coordination"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/decomp/*"
      ],
      "checks": [
        "decomp"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/pdf2md/*"
      ],
      "checks": [
        "pdf2md"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/release/*"
      ],
      "checks": [
        "release"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/reporting/*"
      ],
      "checks": [
        "reporting"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/retrieval/*"
      ],
      "checks": [
        "retrieval"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/scope_of_work/*"
      ],
      "checks": [
        "scope_of_work"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/source_audit/*"
      ],
      "checks": [
        "source_audit"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/source_catalog/*"
      ],
      "checks": [
        "source_catalog"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/workflow_runtime/*"
      ],
      "checks": [
        "workflow_runtime"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        ".github/workflows/governance-harness.yml",
        "pyproject.toml",
        "tools/tools-test-routing.json",
        "tools/run_affected_tests.py",
        "tools/software_workflow/*",
        "tools/*/conftest.py"
      ],
      "checks": [
        "coordination",
        "decomp",
        "pdf2md",
        "release",
        "reporting",
        "retrieval",
        "scope_of_work",
        "software_workflow",
        "source_audit",
        "source_catalog",
        "validation",
        "workflow_runtime",
        "evaluation",
        "scaffolding",
        "deliverables",
        "drawing_extract",
        "equation_audit",
        "publication"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ],
      "repository_checks": [
        "instructions",
        "deliverables"
      ]
    },
    {
      "paths": [
        "workflows/*",
        "agents/*"
      ],
      "checks": [
        "workflow_runtime",
        "validation"
      ],
      "repository_checks": [
        "instructions"
      ]
    },
    {
      "paths": [
        "tools/evaluation/*"
      ],
      "checks": [
        "evaluation"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/scaffolding/*"
      ],
      "checks": [
        "scaffolding"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/deliverables/*"
      ],
      "checks": [
        "deliverables"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ],
      "repository_checks": [
        "deliverables"
      ]
    },
    {
      "paths": [
        "tools/validation/**",
        "AGENTS.md",
        "agents/**",
        "workflows/**"
      ],
      "checks": [
        "validation"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ],
      "repository_checks": [
        "instructions"
      ]
    },
    {
      "paths": [
        ".github/actions/restore-build-cache/**"
      ],
      "checks": [
        "software_workflow"
      ]
    },
    {
      "paths": [
        "tools/validation/check_amendment_reopen.py"
      ],
      "checks": [
        "scaffolding"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/drawing_extract/*"
      ],
      "checks": [
        "drawing_extract"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/equation_audit/*"
      ],
      "checks": [
        "equation_audit"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "paths": [
        "tools/publication/*"
      ],
      "checks": [
        "publication"
      ],
      "exclude_paths": [
        "tools/*/README.md"
      ]
    },
    {
      "description": "Maintained headers and bootstrap wrapper are read by test_document_metadata.",
      "paths": [
        "tools/*/README.md",
        "docs/*.md",
        "docs/document-metadata.schema.json",
        "init/init-prompt.md",
        "loop/LOOP_INIT.md",
        "CLAUDE.md"
      ],
      "checks": [
        "validation"
      ]
    },
    {
      "description": "Skill metadata, companions and resources are consumed by catalog validation and workflow resolution.",
      "paths": [
        ".agents/skills/*"
      ],
      "checks": [
        "validation",
        "workflow_runtime"
      ],
      "repository_checks": [
        "instructions"
      ]
    },
    {
      "description": "Manual renderer contract tests import this renderer with its pinned dependencies.",
      "paths": [
        "docs/alignment-manual/render_manual.py",
        "docs/alignment-manual/requirements.txt"
      ],
      "checks": [
        "publication"
      ]
    },
    {
      "description": "Locality documents and evidence are inspected by the dependency structure check.",
      "paths": [
        "execution/PKG-*/DEL-*/deliverable.yaml",
        "execution/PKG-*/DEL-*/ScopeOfWork.md",
        "execution/PKG-*/DEL-*/Work/*.md"
      ],
      "checks": [],
      "repository_checks": [
        "deliverables"
      ]
    },
    {
      "description": "Published prose, rendered editions and retained illustration; no behavior test consumes their bodies.",
      "paths": [
        "README.md",
        "LICENSE.md",
        "tools/EXTERNAL_TOOLS.md",
        "tools/REGISTRY.md",
        "docs/alignment-manual/*.html",
        "docs/human-team-courses/*.html",
        "docs/alignment-manual/assets/Figure_1_1.png"
      ],
      "checks": []
    },
    {
      "description": "Retained decomposition and amendment inputs receive structural checks; no behavior test consumes their checked-in bodies.",
      "paths": [
        "execution/_Coordination/LOOP_INIT.md",
        "execution/_Coordination/PUBLICATION_ROADMAP.md",
        "execution/_Decomposition/*.md",
        "execution/_Decomposition/checkpoint_snapshots/*",
        "execution/_ScopeChange/SCA-20261101-UNDERTAKING-EVALUATION.md",
        "execution/_ScopeChange/SCA-20261101-UNDERTAKING-EVALUATION/*"
      ],
      "checks": [],
      "repository_checks": [
        "deliverables"
      ]
    },
    {
      "description": "Repository configuration, legacy tools and the external Rust reproduction have no narrower demonstrated coverage.",
      "paths": [
        ".editorconfig",
        ".gitattributes",
        ".gitignore",
        "tools/aggregation/*",
        "tools/diagnostics/ka_coverage_audit.py",
        "tools/domain_extract/assemble_equipment_master_csv.py",
        "tools/query/*.sh",
        "tools/review/*.py",
        "tools/workflow_runtime/fixtures/app_workflow_reader.rs"
      ],
      "checks": [
        "coordination",
        "decomp",
        "pdf2md",
        "release",
        "reporting",
        "retrieval",
        "scope_of_work",
        "software_workflow",
        "source_audit",
        "source_catalog",
        "validation",
        "workflow_runtime",
        "evaluation",
        "scaffolding",
        "deliverables",
        "drawing_extract",
        "equation_audit",
        "publication"
      ],
      "repository_checks": [
        "instructions",
        "deliverables"
      ]
    },
    {
      "description": "Scope parsers and ID catalog are imported by validators, reporting, evaluation and the validator exercised by scaffolding.",
      "paths": [
        "tools/scope_of_work/common.py",
        "tools/scope_of_work/id_catalog.json"
      ],
      "checks": [
        "validation",
        "reporting",
        "evaluation",
        "scaffolding"
      ]
    },
    {
      "description": "Current-locality tests execute the substantive scope validator.",
      "paths": [
        "tools/scope_of_work/validate_scope_of_work.py"
      ],
      "checks": [
        "scaffolding"
      ]
    },
    {
      "description": "Scaffolding tests execute the shared fileset checker.",
      "paths": [
        "tools/validation/check_min_viable_fileset.sh"
      ],
      "checks": [
        "scaffolding"
      ]
    },
    {
      "description": "Retrieval imports packet schemas and database helpers.",
      "paths": [
        "tools/source_catalog/research_packet.py",
        "tools/source_catalog/source_database.py"
      ],
      "checks": [
        "retrieval"
      ]
    },
    {
      "description": "Scaffolding imports declaration parsing; evaluation executes the dependency CLI.",
      "paths": [
        "tools/deliverables/*.py"
      ],
      "checks": [
        "scaffolding",
        "evaluation"
      ]
    },
    {
      "description": "Dispatch-brief rendering reads the required fields from these workflow contracts.",
      "paths": [
        "workflows/dbm-concordance-verify/CONTRACT.md",
        "workflows/dbm-section-publish/CONTRACT.md",
        "workflows/dbm-publish/CONTRACT.md"
      ],
      "checks": [
        "publication"
      ]
    }
  ]
}
