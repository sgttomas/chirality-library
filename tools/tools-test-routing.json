{
  "schema": "chirality-software-workflow/v1",
  "project_root": "..",
  "description": "Path-selected tool regression tests. Repository hygiene checks run separately. Unknown tool inputs and unavailable diffs select the full estate; unrelated prose selects none.",
  "always_checks": [],
  "checks": {
    "coordination": {
      "pytest_paths": [
        "tools/coordination"
      ]
    },
    "decomp": {
      "pytest_paths": [
        "tools/decomp"
      ]
    },
    "pdf2md": {
      "pytest_paths": [
        "tools/pdf2md"
      ]
    },
    "release": {
      "pytest_paths": [
        "tools/release"
      ]
    },
    "reporting": {
      "pytest_paths": [
        "tools/reporting"
      ]
    },
    "retrieval": {
      "pytest_paths": [
        "tools/retrieval"
      ]
    },
    "scope_of_work": {
      "pytest_paths": [
        "tools/scope_of_work"
      ]
    },
    "software_workflow": {
      "pytest_paths": [
        "tools/software_workflow"
      ]
    },
    "source_audit": {
      "pytest_paths": [
        "tools/source_audit"
      ]
    },
    "source_catalog": {
      "pytest_paths": [
        "tools/source_catalog"
      ]
    },
    "validation": {
      "pytest_paths": [
        "tools/validation"
      ]
    },
    "workflow_runtime": {
      "pytest_paths": [
        "tools/workflow_runtime"
      ]
    },
    "evaluation": {
      "pytest_paths": [
        "tools/evaluation"
      ]
    },
    "scaffolding": {
      "pytest_paths": [
        "tools/scaffolding"
      ]
    },
    "deliverables": {
      "pytest_paths": [
        "tools/deliverables"
      ]
    },
    "drawing_extract": {
      "pytest_paths": [
        "tools/drawing_extract"
      ]
    },
    "equation_audit": {
      "pytest_paths": [
        "tools/equation_audit"
      ]
    },
    "publication": {
      "pytest_paths": [
        "tools/publication"
      ]
    }
  },
  "path_rules": [
    {
      "paths": [
        "tools/coordination/*"
      ],
      "checks": [
        "coordination"
      ]
    },
    {
      "paths": [
        "tools/decomp/*"
      ],
      "checks": [
        "decomp"
      ]
    },
    {
      "paths": [
        "tools/pdf2md/*"
      ],
      "checks": [
        "pdf2md"
      ]
    },
    {
      "paths": [
        "tools/release/*"
      ],
      "checks": [
        "release"
      ]
    },
    {
      "paths": [
        "tools/reporting/*"
      ],
      "checks": [
        "reporting"
      ]
    },
    {
      "paths": [
        "tools/retrieval/*"
      ],
      "checks": [
        "retrieval"
      ]
    },
    {
      "paths": [
        "tools/scope_of_work/*"
      ],
      "checks": [
        "scope_of_work"
      ]
    },
    {
      "paths": [
        "tools/source_audit/*"
      ],
      "checks": [
        "source_audit"
      ]
    },
    {
      "paths": [
        "tools/source_catalog/*"
      ],
      "checks": [
        "source_catalog"
      ]
    },
    {
      "paths": [
        "tools/workflow_runtime/*"
      ],
      "checks": [
        "workflow_runtime"
      ]
    },
    {
      "paths": [
        ".github/workflows/governance-harness.yml",
        "pyproject.toml",
        "tools/tools-test-routing.json",
        "tools/run_affected_tests.py",
        "tools/software_workflow/*",
        "tools/*/conftest.py"
      ],
      "checks": [
        "coordination",
        "decomp",
        "pdf2md",
        "release",
        "reporting",
        "retrieval",
        "scope_of_work",
        "software_workflow",
        "source_audit",
        "source_catalog",
        "validation",
        "workflow_runtime",
        "evaluation",
        "scaffolding",
        "deliverables",
        "drawing_extract",
        "equation_audit",
        "publication"
      ]
    },
    {
      "paths": [
        "workflows/*",
        "agents/*"
      ],
      "checks": [
        "workflow_runtime",
        "validation"
      ]
    },
    {
      "paths": [
        "tools/evaluation/*"
      ],
      "checks": [
        "evaluation"
      ]
    },
    {
      "paths": [
        "tools/scaffolding/*"
      ],
      "checks": [
        "scaffolding"
      ]
    },
    {
      "paths": [
        "tools/deliverables/*"
      ],
      "checks": [
        "deliverables"
      ]
    },
    {
      "paths": [
        "tools/validation/**",
        "AGENTS.md",
        "agents/**",
        "workflows/**"
      ],
      "checks": [
        "validation"
      ]
    },
    {
      "paths": [
        ".github/actions/restore-build-cache/**"
      ],
      "checks": [
        "software_workflow"
      ]
    },
    {
      "paths": [
        "tools/validation/check_amendment_reopen.py"
      ],
      "checks": [
        "scaffolding"
      ]
    },
    {
      "paths": [
        "tools/drawing_extract/*"
      ],
      "checks": [
        "drawing_extract"
      ]
    },
    {
      "paths": [
        "tools/equation_audit/*"
      ],
      "checks": [
        "equation_audit"
      ]
    },
    {
      "paths": [
        "tools/publication/*"
      ],
      "checks": [
        "publication"
      ]
    }
  ]
}
